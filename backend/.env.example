# Library Management System — environment configuration
# All values are optional. Defaults are SQLite + dev secret.

# --- Database --------------------------------------------------------------
# Default: SQLite file at backend/library.db (auto-created on startup).
# Uncomment to use PostgreSQL instead.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/library_db

# --- Session signing -------------------------------------------------------
# Used to sign session cookies. CHANGE this in production.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Fine policy -----------------------------------------------------------
# Loan period (days) and fine rate (per day past due, in your local currency).
LOAN_PERIOD_DAYS=14
FINE_PER_DAY=0.50

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins for the React dev server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
